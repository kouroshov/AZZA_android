# Copy to local.properties (Android Studio writes sdk.dir itself).
# sdk.dir=C\:\Users\<you>\AppData\Local\Android\Sdk

# apps/api base URL for DEBUG builds. Default: the emulator's alias for the
# host machine. For a physical phone on the same Wi-Fi/hotspot use the PC's
# LAN address, e.g. http://192.168.1.20:4000/api/v1/
# azza.apiBaseUrl=http://10.0.2.2:4000/api/v1/
