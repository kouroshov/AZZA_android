<?xml version="1.0" encoding="utf-8"?>
<!-- The session is encrypted under a Keystore key that does not travel with a
     backup; restoring it elsewhere would only leave an unreadable blob. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
